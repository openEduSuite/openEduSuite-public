#
# ILIAS backchannel logout configuration
# This file configures SAML backchannel logout for ILIAS
#

ilias:
  # Enable SAML authentication with backchannel logout
  saml:
    enabled: true

    # Backchannel logout configuration
    backchannelLogout:
      enabled: {{ dig "backchannelLogout" "saml" "ilias" "enabled" "false" .Values | quote }}

    # SAML SP (Service Provider) configuration
    sp:
      entityId: "https://lms.{{ .Values.global.domain }}/shibboleth"
      assertionConsumerService: "https://lms.{{ .Values.global.domain }}/Shibboleth.sso/SAML2/POST"
      singleLogoutService: "https://lms.{{ .Values.global.domain }}/Shibboleth.sso/Logout"

    # SAML IdP (Identity Provider) configuration
    idp:
      entityId: "https://id.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}"
      singleSignOnService: "https://id.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/saml"
      singleLogoutService: "https://id.{{ .Values.global.domain }}/realms/{{ .Values.platform.realm }}/protocol/saml"

  # Apache Shibboleth integration
  shibboleth:
    enabled: true

    # Backchannel logout settings
    backchannelLogout:
      enabled: {{ dig "backchannelLogout" "saml" "ilias" "enabled" "false" .Values | quote }}

      # SOAP binding (backchannel)
      soapBinding: {{ dig "backchannelLogout" "saml" "ilias" "bindings" "soap" "true" .Values | quote }}

      # HTTP-Redirect binding (frontchannel)
      redirectBinding: {{ dig "backchannelLogout" "saml" "ilias" "bindings" "httpRedirect" "true" .Values | quote }}

      # HTTP-POST binding (frontchannel)
      postBinding: {{ dig "backchannelLogout" "saml" "ilias" "bindings" "httpPost" "true" .Values | quote }}

      # Signature requirements
      signature:
        requireSignedRequests: {{ dig "backchannelLogout" "saml" "ilias" "signature" "requireSignedRequests" "true" .Values | quote }}
        signResponses: {{ dig "backchannelLogout" "saml" "ilias" "signature" "signResponses" "true" .Values | quote }}

      # Session termination timeout
      sessionTerminationTimeout: {{ dig "backchannelLogout" "saml" "ilias" "sessionTerminationTimeout" "30" .Values | quote }}

      # Verbose logging
      verbose: {{ dig "backchannelLogout" "saml" "ilias" "verbose" "false" .Values | quote }}

  # ILIAS authentication plugin configuration
  auth:
    shibboleth:
      enabled: true

      # Map SAML attributes to ILIAS user fields
      attributeMapping:
        username: "uid"
        email: "mail"
        firstname: "displayName"
        lastname: "sn"
        idp: "idp-entity-id"

      # Backchannel logout behavior
      logout:
        enabled: {{ dig "backchannelLogout" "saml" "ilias" "enabled" "false" .Values | quote }}
        revokeSession: true
        redirectAfterLogout: "https://portal.{{ .Values.global.domain }}"

  # Dependency: Shibboleth SP configuration
  dependencies:
    shibboleth-sp:
      enabled: true

      # ConfigMap with Shibboleth SP configuration
      configMap: ilias-shibboleth-config

      # SP metadata URL
      metadataUrl: "https://lms.{{ .Values.global.domain }}/Shibboleth.sso/Metadata"
