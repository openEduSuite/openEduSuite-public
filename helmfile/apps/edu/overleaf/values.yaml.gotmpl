# --- public-variant (sync-keep): intentional local fix; not overwritten by sync-public.sh push ---
---
global:
  domain: {{ .Values.global.domain | quote }}
ingress:
  enabled: true
  hosts:
    - "latex.{{ .Values.global.domain }}"
  annotations:
    kubernetes.io/ingress.class: haproxy
    haproxy-ingress.github.io/ssl-redirect: "true"
image:
  registry: "registry.example.com"
  repository: "opendesk/sharelatex"
  tag: "latest"
