---
commonAnnotations: {}

bigbluebutton:
  image: "ghcr.io/<your-org>/greenlight-saml"
  tag: "v1.3.0"
  replicaCount: 2
  
  # Greenlight SAML configuration for Sharad
  greenlight:
    default_registration: "saml"
    saml:
      idp_entityId: "https://id.openedusuite.example.com/realms/openedusuite"
      idp_sso_target_url: "https://id.openedusuite.example.com/realms/openedusuite/protocol/saml"
      sp_entityId: "https://bbb.openedusuite.example.com/shibboleth"

# Ingress configuration
ingress:
  enabled: true
  className: "haproxy"
  annotations:
    haproxy-ingress.github.io/ssl-redirect: "true"
    haproxy-ingress.github.io/timeout-server: "120000ms"
    haproxy-ingress.github.io/timeout-client: "120000ms"
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
  hosts:
    host: "bbb.openedusuite.example.com"
    paths:
      path: /
      pathType: "ImplementationSpecific"
  tls:
    secretName: "openedusuite-certificates-tls"
    hosts:
      - "bbb.openedusuite.example.com"

# Shibboleth configuration
shibboleth:
  enabled: true
  sp:
    host: "bbb.openedusuite.example.com"
    entityID: "https://bbb.openedusuite.example.com/shibboleth"

# BoldChat SAML configuration
boldchat:
  enabled: true
  label: "OpenDesk Login"
  icon: //img.icons8.com/color/96/lock.png
  provider: :saml
  params:
    assertion_consumer_service_url: "https://bbb.openedusuite.example.com/auth/saml2/callback"
    sp_entity_id: "https://bbb.openedusuite.example.com/shibboleth"
    idp_entity_id: "https://id.openedusuite.example.com/realms/openedusuite"
    idp_sso_target_url: "https://id.openedusuite.example.com/realms/openedusuite/protocol/saml"
    idp_slo_target_url: "https://id.openedusuite.example.com/realms/openedusuite/protocol/saml"
    idp_metadata_url: "https://id.openedusuite.example.com/realms/openedusuite/protocol/saml/descriptor"
    allowed_clock_drift: 120
  secrets:
    certificate: /etc/shibboleth/shib-cert.pem
    private_key: /etc/shibboleth/shib-key.pem
  recordings:
    require_login: false
    allow_guests: false

# Service configuration
service:
  annotations: {}
  externalPort: 80
  enabled: true

# Backchannel logout configuration (SAML)
extraVolumes:
  - name: bbb-saml-backchannel-controller
    configMap:
      name: bbb-saml-backchannel-controller

extraVolumeMounts:
  - name: bbb-saml-backchannel-controller
    mountPath: /home/app/greenlight/app/controllers/saml_backchannel_controller.rb
    subPath: saml_backchannel_controller.rb
    readOnly: true