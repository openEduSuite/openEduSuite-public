#
# Monitoring values
# =================
# Values for blackbox-probes, opentelemetry-collector, and tempo charts.

# ---------------------------------------------------------------------------
# Blackbox probes
# ---------------------------------------------------------------------------
# All probe targets are defined in the chart's values.yaml.
# Phase-1: no prometheus-operator (no PrometheusRule CRD) — disable the chart's
# alert-rule rendering so only the probe-target ConfigMap is produced; re-enable
# once the monitoring stack (and its CRDs) is installed. Keys are CHART-level
# (the chart does not nest under blackboxProbes).
alerts:
  enabled: false
blackboxExporter:
  address: blackbox-exporter.monitoring.svc.cluster.local:9115

# ---------------------------------------------------------------------------
# OpenTelemetry Collector
# ---------------------------------------------------------------------------
otelCollector:
  mode: both
  tempo:
    enabled: true
    address: tempo.openedusuite.svc.cluster.local:4317
  monitoring:
    serviceMonitor:
      enabled: true

# ---------------------------------------------------------------------------
# Tempo
# ---------------------------------------------------------------------------
tempo:
  storage:
    backend: local
    local:
      size: 50Gi
  monitoring:
    serviceMonitor:
      enabled: true
  grafana:
    datasource:
      enabled: true
      namespace: monitoring
