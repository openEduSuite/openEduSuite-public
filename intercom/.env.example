#
# Sanitized example environment for the public distribution.
# Replace the example.org / example.com hosts with your deployment's domains
# (internal deployments patch these to their own operator domains).
#
# Copy this file to .env or .env.prod and adjust values for your environment.
# --- public-variant (sync-keep): sanitized copy; sync-public.sh push never overwrites ---

# === Intercom Service ===
BASE_URL=https://ics.opendesk.example.com
PORT=8008
LOG_LEVEL=DEBUG
ORIGIN_REGEX=opendesk\.example\.com
SECRET=change-me-to-a-random-secret
PROXY=false

# === OIDC / Keycloak ===
ISSUER_BASE_URL=https://id.opendesk.example.com/realms/opendesk
CLIENT_ID=opendesk-intercom
CLIENT_SECRET=change-me
KEYCLOAK_URL=https://id.opendesk.example.com
REALM_NAME=opendesk

# === Session ===
ENABLE_SESSION_COOKIE=true
SESSION_ROLLING_DURATION=86400

# === Claims ===
USER_UNIQUE_MAPPER=opendesk_username
USERNAME_CLAIM=opendesk_username

# === Redis ===
REDIS_HOST=redis-headless
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_USER=default
REDIS_SSL=false
REDIS_MTLS=false

# === Portal ===
PORTAL_URL=https://portal.opendesk.example.com
PORTAL_API_KEY=change-me

# === Matrix ===
MATRIX_ENABLED=true
MATRIX_URL=https://matrix.opendesk.example.com
MATRIX_SERVER_NAME=matrix.opendesk.example.com
MATRIX_AS_SECRET=change-me

# === Nordeck ===
NORDECK_MODE=test
NORDECK_URL=https://matrix-neodatefix-bot.opendesk.example.com

# === XWiki ===
XWIKI_ENABLED=true
XWIKI_URL=https://wiki.opendesk.example.com
XWIKI_AUDIENCE=opendesk-xwiki

# === Nextcloud (legacy - upstream compatibility) ===
NC_ENABLED=false
NC_URL=https://files.opendesk.example.com
NC_AUDIENCE=opendesk-nextcloud

# === OpenCloud (openEduSuite primary file service) ===
OC_ENABLED=true
OC_URL=https://opencloud.opendesk.example.com
OC_AUDIENCE=opendesk-opencloud

# === SOGo Groupware (CalDAV, CardDAV) ===
SOGO_ENABLED=true
SOGO_URL=https://sogo.opendesk.example.com
SOGO_AUDIENCE=opendesk-sogo

# === ILIAS LMS ===
ILIAS_ENABLED=true
ILIAS_URL=https://lms.opendesk.example.com
ILIAS_AUDIENCE=opendesk-ilias
